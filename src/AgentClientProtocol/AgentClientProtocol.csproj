<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not asserting IsAotCompatible: the polymorphic JsonConverters (ContentBlock,
         SessionUpdate, ToolCallContent, McpServer, RequestPermissionOutcome,
         EmbeddedResourceResource) fall back to reflection-based JsonSerializer calls
         (IL2026/IL3050), so enabling the AOT analyzer produces genuine warnings. The
         original project set this via a misspelled property ("IsAotCompitable") that
         never took effect. Route those converters through the source-gen
         AcpJsonSerializerContext to make AOT support real, then flip this to true. -->
    <IsAotCompatible>false</IsAotCompatible>

    <!-- NuGet Packaging -->
    <PackageId>AgentClientProtocol</PackageId>
    <PackageTags>acp;agentclientprotocol</PackageTags>
    <Description>Unofficial C# SDK for ACP (Agent Client Protocol) clients and agents</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <EmbeddedResource Include="..\..\LICENSE" />
  </ItemGroup>


  <ItemGroup Condition="$(TargetFramework) == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>